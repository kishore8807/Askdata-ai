# PostgreSQL application account
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Optional separate account for executing validated user SQL
POSTGRES_EXEC_USER=
POSTGRES_EXEC_PASSWORD=

# Generate a unique value of at least 32 characters before starting the API.
SECRET_KEY=
SESSION_EXPIRE_MINUTES=60
COOKIE_SECURE=false
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# Local Ollama service
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=120

# Database and request limits
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT=5
SQL_STATEMENT_TIMEOUT_MS=15000
SQL_MAX_RESULT_ROWS=1000
MAX_UPLOAD_MB=5
MAX_ATTACH_ROWS=500
MAX_ATTACH_COLUMNS=50
MAX_STATEMENTS=500
MAX_SQL_LENGTH=1000000
MAX_EXPORT_ROWS=20000

# Optional RBAC override file and trusted reverse proxies
PERMISSIONS_FILE=
TRUSTED_PROXIES=127.0.0.1,::1

# Flask front door
BACKEND_URL=http://127.0.0.1:8000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5000
